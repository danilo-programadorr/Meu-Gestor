rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function profileFields() {
      return [
        'ownerId',
        'displayName',
        'locale',
        'currencyCode',
        'timeZone',
        'emailVerifiedSnapshot',
        'termsVersionAccepted',
        'termsAcceptedAt',
        'privacyVersionAccepted',
        'privacyAcceptedAt',
        'aiConsentEnabled',
        'aiConsentUpdatedAt',
        'analyticsConsentEnabled',
        'analyticsConsentUpdatedAt',
        'createdAt',
        'updatedAt',
        'schemaVersion'
      ];
    }

    function hasExactProfileFields(data) {
      return data.keys().hasAll(profileFields())
        && data.keys().hasOnly(profileFields());
    }

    function isValidDisplayName(displayName) {
      return displayName is string
        && displayName.size() >= 2
        && displayName.size() <= 80
        && displayName.matches('^[^\\x00-\\x20\\x7F].*[^\\x00-\\x20\\x7F]$')
        && !displayName.matches('.*[\\x00-\\x1F\\x7F].*')
        && !displayName.matches('.*  .*');
    }

    function hasValidProfileTypes(data) {
      return data.ownerId is string
        && data.displayName is string
        && data.locale is string
        && data.currencyCode is string
        && data.timeZone is string
        && data.emailVerifiedSnapshot is bool
        && data.termsVersionAccepted is string
        && data.termsAcceptedAt is timestamp
        && data.privacyVersionAccepted is string
        && data.privacyAcceptedAt is timestamp
        && data.aiConsentEnabled is bool
        && data.aiConsentUpdatedAt is timestamp
        && data.analyticsConsentEnabled is bool
        && data.analyticsConsentUpdatedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion is int;
    }

    function hasValidFixedValues(data, userId) {
      return data.ownerId == userId
        && data.locale == 'pt-BR'
        && data.currencyCode == 'BRL'
        && data.timeZone == 'America/Sao_Paulo'
        && data.emailVerifiedSnapshot == true
        && data.termsVersionAccepted == 'terms-dev-1.0.0'
        && data.privacyVersionAccepted == 'privacy-dev-1.0.0'
        && data.schemaVersion == 1
        && isValidDisplayName(data.displayName);
    }

    function isValidProfile(data, userId) {
      return hasExactProfileFields(data)
        && hasValidProfileTypes(data)
        && hasValidFixedValues(data, userId);
    }

    function isValidCreate(userId) {
      let data = request.resource.data;
      return isValidProfile(data, userId)
        && data.termsAcceptedAt == request.time
        && data.privacyAcceptedAt == request.time
        && data.aiConsentUpdatedAt == request.time
        && data.analyticsConsentUpdatedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidPairedTransition(valueField, timestampField) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
          changed.hasAny([valueField])
          && changed.hasAny([timestampField])
          && request.resource.data[timestampField] == request.time
        ) || (
          !changed.hasAny([valueField])
          && !changed.hasAny([timestampField])
          && request.resource.data[timestampField] == resource.data[timestampField]
        );
    }

    function isValidUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isValidProfile(data, userId)
        && changed.hasAny([
          'displayName',
          'emailVerifiedSnapshot',
          'termsVersionAccepted',
          'termsAcceptedAt',
          'privacyVersionAccepted',
          'privacyAcceptedAt',
          'aiConsentEnabled',
          'aiConsentUpdatedAt',
          'analyticsConsentEnabled',
          'analyticsConsentUpdatedAt'
        ])
        && changed.hasOnly([
          'displayName',
          'emailVerifiedSnapshot',
          'termsVersionAccepted',
          'termsAcceptedAt',
          'privacyVersionAccepted',
          'privacyAcceptedAt',
          'aiConsentEnabled',
          'aiConsentUpdatedAt',
          'analyticsConsentEnabled',
          'analyticsConsentUpdatedAt',
          'updatedAt'
        ])
        && data.updatedAt == request.time
        && data.ownerId == resource.data.ownerId
        && data.createdAt == resource.data.createdAt
        && data.locale == resource.data.locale
        && data.currencyCode == resource.data.currencyCode
        && data.timeZone == resource.data.timeZone
        && data.schemaVersion == resource.data.schemaVersion
        && hasValidPairedTransition(
          'aiConsentEnabled',
          'aiConsentUpdatedAt'
        )
        && hasValidPairedTransition(
          'analyticsConsentEnabled',
          'analyticsConsentUpdatedAt'
        )
        && hasValidPairedTransition(
          'termsVersionAccepted',
          'termsAcceptedAt'
        )
        && hasValidPairedTransition(
          'privacyVersionAccepted',
          'privacyAcceptedAt'
        );
    }

    function accountFields() {
      return [
        'ownerId',
        'name',
        'type',
        'openingBalanceCents',
        'currencyCode',
        'includeInTotal',
        'isArchived',
        'archivedAt',
        'createdAt',
        'updatedAt',
        'schemaVersion'
      ];
    }

    function hasExactAccountFields(data) {
      return data.keys().hasAll(accountFields())
        && data.keys().hasOnly(accountFields());
    }

    function isValidAccountName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 60
        && name.matches('^[^\\x00-\\x20\\x7F].*[^\\x00-\\x20\\x7F]$')
        && !name.matches('.*[\\x00-\\x1F\\x7F].*')
        && !name.matches('.*  .*');
    }

    function isValidAccountType(type) {
      return type is string
        && type in [
          'checking',
          'savings',
          'cash',
          'digitalWallet',
          'investment',
          'other'
        ];
    }

    function hasValidAccountTypes(data) {
      return data.ownerId is string
        && data.name is string
        && data.type is string
        && data.openingBalanceCents is int
        && data.currencyCode is string
        && data.includeInTotal is bool
        && data.isArchived is bool
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion is int;
    }

    function isValidAccount(data, userId) {
      return hasExactAccountFields(data)
        && hasValidAccountTypes(data)
        && data.ownerId == userId
        && isValidAccountName(data.name)
        && isValidAccountType(data.type)
        && data.openingBalanceCents >= -9999999999
        && data.openingBalanceCents <= 9999999999
        && data.currencyCode == 'BRL'
        && data.schemaVersion == 1
        && data.isArchived == (data.archivedAt != null);
    }

    function isValidAccountCreate(userId) {
      let data = request.resource.data;
      return isValidAccount(data, userId)
        && data.isArchived == false
        && data.archivedAt == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidArchiveTransition() {
      let data = request.resource.data;
      return (
          data.isArchived == resource.data.isArchived
          && data.archivedAt == resource.data.archivedAt
        ) || (
          resource.data.isArchived == false
          && data.isArchived == true
          && data.archivedAt == request.time
        ) || (
          resource.data.isArchived == true
          && data.isArchived == false
          && data.archivedAt == null
        );
    }

    function isValidAccountUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isValidAccount(data, userId)
        && changed.hasAny([
          'name',
          'type',
          'openingBalanceCents',
          'includeInTotal',
          'isArchived',
          'archivedAt'
        ])
        && changed.hasOnly([
          'name',
          'type',
          'openingBalanceCents',
          'includeInTotal',
          'isArchived',
          'archivedAt',
          'updatedAt'
        ])
        && data.updatedAt == request.time
        && data.ownerId == resource.data.ownerId
        && data.createdAt == resource.data.createdAt
        && data.currencyCode == resource.data.currencyCode
        && data.schemaVersion == resource.data.schemaVersion
        && hasValidArchiveTransition();
    }

    function categoryFields() {
      return [
        'ownerId',
        'name',
        'kind',
        'iconKey',
        'colorKey',
        'isArchived',
        'archivedAt',
        'createdAt',
        'updatedAt',
        'schemaVersion'
      ];
    }

    function hasExactCategoryFields(data) {
      return data.keys().hasAll(categoryFields())
        && data.keys().hasOnly(categoryFields());
    }

    function isValidCategoryName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 40
        && name.matches('^[^\\x00-\\x20\\x7F].*[^\\x00-\\x20\\x7F]$')
        && !name.matches('.*[\\x00-\\x1F\\x7F].*')
        && !name.matches('.*  .*');
    }

    function isValidCategoryKind(kind) {
      return kind is string && kind in ['income', 'expense'];
    }

    function isValidCategoryIcon(iconKey) {
      return iconKey is string
        && iconKey in [
          'salary',
          'extraIncome',
          'sale',
          'refund',
          'food',
          'home',
          'transport',
          'health',
          'education',
          'leisure',
          'subscription',
          'shopping',
          'bill',
          'other'
        ];
    }

    function isValidCategoryColor(colorKey) {
      return colorKey is string
        && colorKey in [
          'cyan',
          'blue',
          'green',
          'purple',
          'orange',
          'pink',
          'red',
          'yellow',
          'teal',
          'gray'
        ];
    }

    function hasValidCategoryTypes(data) {
      return data.ownerId is string
        && data.name is string
        && data.kind is string
        && data.iconKey is string
        && data.colorKey is string
        && data.isArchived is bool
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion is int;
    }

    function isValidCategory(data, userId) {
      return hasExactCategoryFields(data)
        && hasValidCategoryTypes(data)
        && data.ownerId == userId
        && isValidCategoryName(data.name)
        && isValidCategoryKind(data.kind)
        && isValidCategoryIcon(data.iconKey)
        && isValidCategoryColor(data.colorKey)
        && data.schemaVersion == 1
        && data.isArchived == (data.archivedAt != null);
    }

    function isValidCategoryCreate(userId) {
      let data = request.resource.data;
      return isValidCategory(data, userId)
        && data.isArchived == false
        && data.archivedAt == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidCategoryArchiveTransition() {
      let data = request.resource.data;
      return (
          data.isArchived == resource.data.isArchived
          && data.archivedAt == resource.data.archivedAt
        ) || (
          resource.data.isArchived == false
          && data.isArchived == true
          && data.archivedAt == request.time
        ) || (
          resource.data.isArchived == true
          && data.isArchived == false
          && data.archivedAt == null
        );
    }

    function isValidCategoryUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isValidCategory(data, userId)
        && changed.hasAny([
          'name',
          'iconKey',
          'colorKey',
          'isArchived',
          'archivedAt'
        ])
        && changed.hasOnly([
          'name',
          'iconKey',
          'colorKey',
          'isArchived',
          'archivedAt',
          'updatedAt'
        ])
        && data.updatedAt == request.time
        && data.ownerId == resource.data.ownerId
        && data.kind == resource.data.kind
        && data.createdAt == resource.data.createdAt
        && data.schemaVersion == resource.data.schemaVersion
        && hasValidCategoryArchiveTransition();
    }

    function transactionFieldsV1() {
      return [
        'ownerId',
        'accountId',
        'categoryId',
        'kind',
        'description',
        'amountCents',
        'occurredAt',
        'notes',
        'isVoided',
        'voidedAt',
        'createdAt',
        'updatedAt',
        'schemaVersion'
      ];
    }

    function transactionFieldsV2() {
      return transactionFieldsV1().concat(['originType', 'originId']);
    }

    function hasExactTransactionFields(data) {
      let schemaVersion = data.get('schemaVersion', 0);
      return (
          schemaVersion == 1
          && data.keys().hasAll(transactionFieldsV1())
          && data.keys().hasOnly(transactionFieldsV1())
        ) || (
          schemaVersion == 2
          && data.keys().hasAll(transactionFieldsV2())
          && data.keys().hasOnly(transactionFieldsV2())
        );
    }

    function isValidReferenceId(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 150
        && !value.matches('.*/.*');
    }

    function isValidTransactionDescription(description) {
      return description is string
        && description.size() >= 2
        && description.size() <= 120
        && description.matches('^[^\\x00-\\x20\\x7F].*[^\\x00-\\x20\\x7F]$')
        && !description.matches('.*[\\x00-\\x1F\\x7F].*')
        && !description.matches('.*  .*');
    }

    function isValidTransactionNotes(notes) {
      return notes is string
        && notes.size() <= 500
        && !notes.matches('.*[\\x00-\\x1F\\x7F].*');
    }

    function hasValidTransactionTypes(data) {
      return data.ownerId is string
        && data.accountId is string
        && data.categoryId is string
        && data.kind is string
        && data.description is string
        && data.amountCents is int
        && data.occurredAt is timestamp
        && data.notes is string
        && data.isVoided is bool
        && (data.voidedAt == null || data.voidedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion is int
        && (
          data.schemaVersion == 1
          || (
            data.originType is string
            && (data.originId == null || data.originId is string)
          )
        );
    }

    function hasValidTransactionOrigin(data) {
      return data.schemaVersion == 1
        ? true
        : data.originType == 'manual'
          ? data.originId == null
          : data.originType in ['payable', 'receivable']
            ? isValidReferenceId(data.originId)
            : false;
    }

    function isValidTransaction(data, userId) {
      return !hasExactTransactionFields(data)
        ? false
        : hasValidTransactionTypes(data)
          && data.ownerId == userId
          && isValidReferenceId(data.accountId)
          && isValidReferenceId(data.categoryId)
          && isValidCategoryKind(data.kind)
          && isValidTransactionDescription(data.description)
          && data.amountCents > 0
          && data.amountCents <= 9999999999
          && data.occurredAt <= request.time
          && isValidTransactionNotes(data.notes)
          && data.schemaVersion in [1, 2]
          && hasValidTransactionOrigin(data)
          && data.isVoided == (data.voidedAt != null);
    }

    function isActiveAccountData(data, userId) {
      return data.ownerId == userId && data.isArchived == false;
    }

    function isActiveAccountReference(userId, accountId) {
      let accountPath = /databases/$(database)/documents/users/$(userId)/accounts/$(accountId);
      return !exists(accountPath)
        ? false
        : isActiveAccountData(get(accountPath).data, userId);
    }

    function isActiveCategoryData(data, userId, kind) {
      return data.ownerId == userId
        && data.isArchived == false
        && data.kind == kind;
    }

    function isActiveCategoryReference(userId, categoryId, kind) {
      let categoryPath = /databases/$(database)/documents/users/$(userId)/categories/$(categoryId);
      return !exists(categoryPath)
        ? false
        : isActiveCategoryData(get(categoryPath).data, userId, kind);
    }

    function isMatchingCommitmentTransaction(commitment, movementAt, transaction, userId, originType, originId, transactionKind) {
      return commitment.ownerId == userId
        && transaction.ownerId == userId
        && commitment.settlementAccountId == transaction.accountId
        && commitment.categoryId == transaction.categoryId
        && commitment.amountCents == transaction.amountCents
        && movementAt == transaction.occurredAt
        && transaction.kind == transactionKind
        && transaction.schemaVersion == 2
        && transaction.originType == originType
        && transaction.originId == originId;
    }

    function isValidLinkedTransactionCreateData(commitment, movementAt, userId, transactionId, data, settledStatus, transactionKind) {
      return commitment.status == settledStatus
        && commitment.updatedAt == request.time
        && commitment.linkedTransactionId == transactionId
        && isMatchingCommitmentTransaction(
          commitment,
          movementAt,
          data,
          userId,
          data.originType,
          data.originId,
          transactionKind
        );
    }

    function isValidPayableTransactionCreateData(commitment, userId, transactionId, data) {
      return isValidLinkedTransactionCreateData(
        commitment,
        commitment.paidAt,
        userId,
        transactionId,
        data,
        'paid',
        'expense'
      );
    }

    function isValidPayableTransactionCreate(userId, transactionId, data) {
      let originPath = /databases/$(database)/documents/users/$(userId)/payables/$(data.originId);
      return existsAfter(originPath)
        && isValidPayableTransactionCreateData(
          getAfter(originPath).data,
          userId,
          transactionId,
          data
        );
    }

    function isValidReceivableTransactionCreateData(commitment, userId, transactionId, data) {
      return isValidLinkedTransactionCreateData(
        commitment,
        commitment.receivedAt,
        userId,
        transactionId,
        data,
        'received',
        'income'
      );
    }

    function isValidReceivableTransactionCreate(userId, transactionId, data) {
      let originPath = /databases/$(database)/documents/users/$(userId)/receivables/$(data.originId);
      return existsAfter(originPath)
        && isValidReceivableTransactionCreateData(
          getAfter(originPath).data,
          userId,
          transactionId,
          data
        );
    }

    function isValidTransactionCreateOrigin(userId, transactionId, data) {
      return data.originType == 'manual'
        ? data.originId == null
          && isActiveAccountReference(userId, data.accountId)
          && isActiveCategoryReference(userId, data.categoryId, data.kind)
        : data.originType == 'payable'
          ? isValidPayableTransactionCreate(userId, transactionId, data)
          : data.originType == 'receivable'
            ? isValidReceivableTransactionCreate(userId, transactionId, data)
            : false;
    }

    function isValidTransactionCreate(userId, transactionId) {
      let data = request.resource.data;
      return !isValidTransaction(data, userId)
        ? false
        : data.schemaVersion == 2
          && data.isVoided == false
          && data.voidedAt == null
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && isValidTransactionCreateOrigin(userId, transactionId, data);
    }

    function isValidTransactionDescriptiveUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.isVoided == false
        && data.isVoided == false
        && data.voidedAt == null
        && changed.hasAny([
          'description',
          'categoryId',
          'occurredAt',
          'notes'
        ])
        && changed.hasOnly([
          'description',
          'categoryId',
          'occurredAt',
          'notes',
          'updatedAt'
        ])
        && data.updatedAt == request.time
        && isValidTransactionDescription(data.description)
        && data.occurredAt is timestamp
        && data.occurredAt <= request.time
        && isValidTransactionNotes(data.notes)
        && isActiveCategoryReference(userId, data.categoryId, data.kind);
    }

    function isValidTransactionVoid() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.isVoided == false
        && resource.data.voidedAt == null
        && data.isVoided == true
        && data.voidedAt == request.time
        && data.updatedAt == request.time
        && changed.hasAll(['isVoided', 'voidedAt'])
        && changed.hasOnly(['isVoided', 'voidedAt', 'updatedAt']);
    }

    function isValidLinkedTransactionVoidData(commitment, movementAt, userId, transactionId, data, transactionKind) {
      return commitment.status == 'voided'
        && commitment.updatedAt == request.time
        && commitment.linkedTransactionId == transactionId
        && isMatchingCommitmentTransaction(
          commitment,
          movementAt,
          data,
          userId,
          data.originType,
          data.originId,
          transactionKind
        );
    }

    function isValidPayableTransactionVoidData(commitment, userId, transactionId, data) {
      return isValidLinkedTransactionVoidData(
        commitment,
        commitment.paidAt,
        userId,
        transactionId,
        data,
        'expense'
      );
    }

    function isValidPayableTransactionVoid(userId, transactionId, data) {
      let originPath = /databases/$(database)/documents/users/$(userId)/payables/$(data.originId);
      return existsAfter(originPath)
        && isValidPayableTransactionVoidData(
          getAfter(originPath).data,
          userId,
          transactionId,
          data
        );
    }

    function isValidReceivableTransactionVoidData(commitment, userId, transactionId, data) {
      return isValidLinkedTransactionVoidData(
        commitment,
        commitment.receivedAt,
        userId,
        transactionId,
        data,
        'income'
      );
    }

    function isValidReceivableTransactionVoid(userId, transactionId, data) {
      let originPath = /databases/$(database)/documents/users/$(userId)/receivables/$(data.originId);
      return existsAfter(originPath)
        && isValidReceivableTransactionVoidData(
          getAfter(originPath).data,
          userId,
          transactionId,
          data
        );
    }

    function isValidLinkedTransactionVoid(userId, transactionId, data) {
      return isValidTransactionVoid()
        && (
          data.originType == 'payable'
          ? isValidPayableTransactionVoid(userId, transactionId, data)
          : data.originType == 'receivable'
            ? isValidReceivableTransactionVoid(userId, transactionId, data)
            : false
        );
    }

    function isValidManualTransactionUpdate(userId, data) {
      return data.isVoided == true
        ? isValidTransactionVoid()
        : isValidTransactionDescriptiveUpdate(userId);
    }

    function isValidTransactionUpdate(userId, transactionId) {
      let data = request.resource.data;
      return data.ownerId != userId
        ? false
        : resource.data.schemaVersion == 1
          ? isValidManualTransactionUpdate(userId, data)
          : resource.data.originType == 'manual'
            ? isValidManualTransactionUpdate(userId, data)
            : data.isVoided == true
              ? isValidLinkedTransactionVoid(userId, transactionId, data)
              : false;
    }

    function commitmentFields(movementField) {
      return [
        'ownerId',
        'description',
        'categoryId',
        'amountCents',
        'dueAt',
        'status',
        movementField,
        'settlementAccountId',
        'linkedTransactionId',
        'cancelledAt',
        'voidedAt',
        'notes',
        'revision',
        'createdAt',
        'updatedAt',
        'schemaVersion'
      ];
    }

    function hasExactCommitmentFields(data, movementField) {
      return data.keys().hasAll(commitmentFields(movementField))
        && data.keys().hasOnly(commitmentFields(movementField));
    }

    function hasValidCommitmentTypes(data, movementField) {
      return data.get('ownerId', null) is string
        && data.get('description', null) is string
        && data.get('categoryId', null) is string
        && data.get('amountCents', null) is int
        && data.get('dueAt', null) is timestamp
        && data.get('status', null) is string
        && (data.get(movementField, null) == null || data.get(movementField, null) is timestamp)
        && (data.get('settlementAccountId', null) == null || data.get('settlementAccountId', null) is string)
        && (data.get('linkedTransactionId', null) == null || data.get('linkedTransactionId', null) is string)
        && (data.get('cancelledAt', null) == null || data.get('cancelledAt', null) is timestamp)
        && (data.get('voidedAt', null) == null || data.get('voidedAt', null) is timestamp)
        && data.get('notes', null) is string
        && data.get('revision', null) is int
        && data.get('createdAt', null) is timestamp
        && data.get('updatedAt', null) is timestamp
        && data.get('schemaVersion', null) is int;
    }

    function hasValidCommitmentState(data, settledStatus, movementField) {
      return data.get('status', '') == 'pending'
        ? data.get(movementField, null) == null
          && data.get('settlementAccountId', null) == null
          && data.get('linkedTransactionId', null) == null
          && data.get('cancelledAt', null) == null
          && data.get('voidedAt', null) == null
        : data.get('status', '') == settledStatus
          ? data.get(movementField, null) is timestamp
            && isValidReferenceId(data.get('settlementAccountId', null))
            && isValidReferenceId(data.get('linkedTransactionId', null))
            && data.get('cancelledAt', null) == null
            && data.get('voidedAt', null) == null
          : data.get('status', '') == 'cancelled'
            ? data.get(movementField, null) == null
              && data.get('settlementAccountId', null) == null
              && data.get('linkedTransactionId', null) == null
              && data.get('cancelledAt', null) is timestamp
              && data.get('voidedAt', null) == null
            : data.get('status', '') == 'voided'
              ? data.get(movementField, null) is timestamp
                && isValidReferenceId(data.get('settlementAccountId', null))
                && isValidReferenceId(data.get('linkedTransactionId', null))
                && data.get('cancelledAt', null) == null
                && data.get('voidedAt', null) is timestamp
              : false;
    }

    function isValidCommitment(data, userId, settledStatus, movementField) {
      return !hasExactCommitmentFields(data, movementField)
        ? false
        : hasValidCommitmentTypes(data, movementField)
          && data.get('ownerId', '') == userId
          && isValidTransactionDescription(data.get('description', null))
          && isValidReferenceId(data.get('categoryId', null))
          && data.get('amountCents', 0) > 0
          && data.get('amountCents', 0) <= 9999999999
          && isValidTransactionNotes(data.get('notes', null))
          && data.get('revision', 0) >= 1
          && data.get('schemaVersion', 0) == 1
          && data.get('updatedAt', request.time) >= data.get('createdAt', request.time)
          && hasValidCommitmentState(data, settledStatus, movementField);
    }

    function isValidCommitmentCreate(userId, kind, settledStatus, movementField) {
      let data = request.resource.data;
      return !isValidCommitment(data, userId, settledStatus, movementField)
        ? false
        : data.get('status', '') == 'pending'
          && data.get('revision', 0) == 1
          && data.get('createdAt', null) == request.time
          && data.get('updatedAt', null) == request.time
          && isActiveCategoryReference(userId, data.get('categoryId', ''), kind);
    }

    function isValidPendingCommitmentEdit(userId, kind) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.status == 'pending'
        && data.status == 'pending'
        && changed.hasAll(['revision'])
        && changed.hasAny([
          'description',
          'categoryId',
          'amountCents',
          'dueAt',
          'notes'
        ])
        && changed.hasOnly([
          'description',
          'categoryId',
          'amountCents',
          'dueAt',
          'notes',
          'revision',
          'updatedAt'
        ])
        && data.revision == resource.data.revision + 1
        && data.updatedAt == request.time
        && isValidTransactionDescription(data.description)
        && data.amountCents is int
        && data.amountCents > 0
        && data.amountCents <= 9999999999
        && data.dueAt is timestamp
        && isValidTransactionNotes(data.notes)
        && isActiveCategoryReference(userId, data.categoryId, kind);
    }

    function isValidPendingCommitmentCancellation() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.status == 'pending'
        && data.status == 'cancelled'
        && data.cancelledAt == request.time
        && data.revision == resource.data.revision + 1
        && data.updatedAt == request.time
        && changed.hasAll(['status', 'cancelledAt', 'revision'])
        && changed.hasOnly(['status', 'cancelledAt', 'revision', 'updatedAt']);
    }

    function transactionPath(userId, transactionId) {
      return /databases/$(database)/documents/users/$(userId)/transactions/$(transactionId);
    }

    function isValidCommitmentSettlementLink(transaction, commitment, movementAt, userId, originType, originId, transactionKind) {
      return transaction.createdAt == request.time
        && transaction.updatedAt == request.time
        && isMatchingCommitmentTransaction(
          commitment,
          movementAt,
          transaction,
          userId,
          originType,
          originId,
          transactionKind
        );
    }

    function isValidCommitmentSettlement(userId, originType, originId, transactionKind, settledStatus, movementField) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let hasValidTransition = resource.data.status == 'pending'
        && data.status == settledStatus
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && changed.hasAll([
          'status',
          movementField,
          'settlementAccountId',
          'linkedTransactionId',
          'revision'
        ])
        && changed.hasOnly([
          'status',
          movementField,
          'settlementAccountId',
          'linkedTransactionId',
          'revision',
          'updatedAt'
        ])
        && isValidReferenceId(data.settlementAccountId)
        && isValidReferenceId(data.linkedTransactionId)
        && isActiveAccountReference(userId, data.settlementAccountId)
        && isActiveCategoryReference(userId, data.categoryId, transactionKind);
      return hasValidTransition
        && existsAfter(transactionPath(userId, data.linkedTransactionId))
        && isValidCommitmentSettlementLink(
          getAfter(transactionPath(userId, data.linkedTransactionId)).data,
          data,
          data[movementField],
          userId,
          originType,
          originId,
          transactionKind
        );
    }

    function isValidCommitmentVoidLink(transaction, commitment, movementAt, userId, originType, originId, transactionKind) {
      return transaction.isVoided == true
        && transaction.voidedAt == request.time
        && transaction.updatedAt == request.time
        && isMatchingCommitmentTransaction(
          commitment,
          movementAt,
          transaction,
          userId,
          originType,
          originId,
          transactionKind
        );
    }

    function isValidCommitmentVoid(userId, originType, originId, transactionKind, settledStatus, movementField) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let hasValidTransition = resource.data.status == settledStatus
        && data.status == 'voided'
        && data.voidedAt == request.time
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && changed.hasAll(['status', 'voidedAt', 'revision'])
        && changed.hasOnly(['status', 'voidedAt', 'revision', 'updatedAt'])
        && isValidReferenceId(data.linkedTransactionId);
      return hasValidTransition
        && existsAfter(transactionPath(userId, data.linkedTransactionId))
        && isValidCommitmentVoidLink(
          getAfter(transactionPath(userId, data.linkedTransactionId)).data,
          data,
          data[movementField],
          userId,
          originType,
          originId,
          transactionKind
        );
    }

    function isValidCommitmentUpdate(userId, originType, originId, kind, settledStatus, movementField) {
      let data = request.resource.data;
      return data.get('ownerId', '') != userId
        ? false
        : resource.data.get('status', '') == 'pending'
          ? data.get('status', '') == 'pending'
            ? isValidPendingCommitmentEdit(userId, kind)
            : data.get('status', '') == 'cancelled'
              ? isValidPendingCommitmentCancellation()
              : data.get('status', '') == settledStatus
                ? isValidCommitmentSettlement(
                  userId,
                  originType,
                  originId,
                  kind,
                  settledStatus,
                  movementField
                )
                : false
          : resource.data.get('status', '') == settledStatus
            ? data.get('status', '') == 'voided'
              ? isValidCommitmentVoid(
                userId,
                originType,
                originId,
                kind,
                settledStatus,
                movementField
              )
              : false
            : false;
    }

    function investmentPortfolioFields() {
      return [
        'ownerId', 'name', 'description', 'isArchived', 'archivedAt',
        'createdAt', 'updatedAt', 'schemaVersion', 'revision'
      ];
    }

    function isValidInvestmentPortfolio(data, userId) {
      return data.keys().hasAll(investmentPortfolioFields())
        && data.keys().hasOnly(investmentPortfolioFields())
        && data.ownerId == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.name.matches('^[^\\x00-\\x20\\x7F](?:.*[^\\x00-\\x20\\x7F])?$')
        && !data.name.matches('.*[\\x00-\\x1F\\x7F].*')
        && !data.name.matches('.*  .*')
        && data.description is string
        && data.description.size() <= 160
        && !data.description.matches('.*[\\x00-\\x1F\\x7F].*')
        && !data.description.matches('.*  .*')
        && data.isArchived is bool
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.isArchived == (data.archivedAt != null)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision >= 1;
    }

    function isValidInvestmentPortfolioCreate(userId) {
      let data = request.resource.data;
      return isValidInvestmentPortfolio(data, userId)
        && data.isArchived == false
        && data.archivedAt == null
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision == 1;
    }

    function isValidInvestmentPortfolioUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isValidInvestmentPortfolio(data, userId)
        && data.ownerId == resource.data.ownerId
        && data.createdAt == resource.data.createdAt
        && data.schemaVersion == resource.data.schemaVersion
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && changed.hasAny(['name', 'description', 'isArchived'])
        && changed.hasOnly([
          'name', 'description', 'isArchived', 'archivedAt', 'updatedAt',
          'revision'
        ])
        && (
          data.isArchived == resource.data.isArchived
            ? data.archivedAt == resource.data.archivedAt
            : resource.data.isArchived == false
              ? data.isArchived == true && data.archivedAt == request.time
              : data.isArchived == false && data.archivedAt == null
        );
    }

    function investmentAssetFields() {
      return [
        'ownerId', 'portfolioId', 'ticker', 'name', 'assetType',
        'currencyCode', 'currentQuantityScaled', 'lastOperationId',
        'lastOperationAt', 'createdAt', 'updatedAt', 'schemaVersion',
        'revision'
      ];
    }

    function isValidInvestmentAsset(data, userId, assetId) {
      return data.keys().hasAll(investmentAssetFields())
        && data.keys().hasOnly(investmentAssetFields())
        && data.ownerId == userId
        && data.portfolioId is string
        && data.portfolioId.size() >= 1
        && data.portfolioId.size() <= 128
        && data.ticker is string
        && data.ticker.matches('^[A-Z]{4}[0-9]{1,2}$')
        && assetId == data.portfolioId + '__' + data.ticker
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.name.matches('^[^\\x00-\\x20\\x7F](?:.*[^\\x00-\\x20\\x7F])?$')
        && !data.name.matches('.*[\\x00-\\x1F\\x7F].*')
        && !data.name.matches('.*  .*')
        && data.assetType in ['stock', 'fii']
        && data.currencyCode == 'BRL'
        && data.currentQuantityScaled is int
        && data.currentQuantityScaled >= 0
        && data.currentQuantityScaled <= 999999999999999
        && (data.lastOperationId == null || data.lastOperationId is string)
        && (data.lastOperationAt == null || data.lastOperationAt is timestamp)
        && (data.lastOperationId == null) == (data.lastOperationAt == null)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision >= 1;
    }

    function investmentPortfolioPath(userId, portfolioId) {
      return /databases/$(database)/documents/users/$(userId)/investmentPortfolios/$(portfolioId);
    }

    function investmentAssetPath(userId, assetId) {
      return /databases/$(database)/documents/users/$(userId)/investmentAssets/$(assetId);
    }

    function investmentOperationPath(userId, operationId) {
      return /databases/$(database)/documents/users/$(userId)/investmentOperations/$(operationId);
    }

    function isActiveInvestmentPortfolio(userId, portfolioId) {
      let path = investmentPortfolioPath(userId, portfolioId);
      return existsAfter(path)
        && getAfter(path).data.ownerId == userId
        && getAfter(path).data.isArchived == false;
    }

    function isValidInvestmentAssetCreate(userId, assetId) {
      let data = request.resource.data;
      return isValidInvestmentAsset(data, userId, assetId)
        && data.currentQuantityScaled == 0
        && data.lastOperationId == null
        && data.lastOperationAt == null
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision == 1
        && isActiveInvestmentPortfolio(userId, data.portfolioId);
    }

    function investmentOperationFields() {
      return [
        'ownerId', 'portfolioId', 'assetId', 'previousOperationId',
        'previousOperationAt', 'kind', 'occurredAt', 'quantityScaled',
        'unitPriceScaled', 'feesCents', 'notes', 'isVoided', 'voidedAt',
        'mutationId', 'createdAt', 'updatedAt', 'schemaVersion', 'revision'
      ];
    }

    function isValidInvestmentOperation(data, userId) {
      return data.keys().hasAll(investmentOperationFields())
        && data.keys().hasOnly(investmentOperationFields())
        && data.ownerId == userId
        && data.portfolioId is string
        && data.portfolioId.size() >= 1
        && data.portfolioId.size() <= 128
        && data.assetId is string
        && data.assetId.size() >= 1
        && data.assetId.size() <= 160
        && (data.previousOperationId == null || data.previousOperationId is string)
        && (data.previousOperationAt == null || data.previousOperationAt is timestamp)
        && (data.previousOperationId == null) == (data.previousOperationAt == null)
        && data.kind in ['buy', 'sell']
        && data.occurredAt is timestamp
        && data.occurredAt <= request.time
        && (data.previousOperationAt == null || data.occurredAt >= data.previousOperationAt)
        && data.quantityScaled is int
        && data.quantityScaled >= 1
        && data.quantityScaled <= 999999999999999
        && data.unitPriceScaled is int
        && data.unitPriceScaled >= 1
        && data.unitPriceScaled <= 999999999999
        && data.feesCents is int
        && data.feesCents >= 0
        && data.feesCents <= 9999999999
        && (
          data.kind == 'buy'
          || data.feesCents <=
            (data.quantityScaled / 100000000.0)
            * (data.unitPriceScaled / 10000.0)
        )
        && data.notes is string
        && data.notes.size() <= 240
        && !data.notes.matches('.*[\\x00-\\x1F\\x7F].*')
        && data.isVoided is bool
        && (data.voidedAt == null || data.voidedAt is timestamp)
        && data.isVoided == (data.voidedAt != null)
        && data.mutationId is string
        && data.mutationId.size() >= 1
        && data.mutationId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision >= 1;
    }

    function isOperationQuantityTransition(beforeAsset, afterAsset, operation) {
      return operation.kind == 'buy'
        ? afterAsset.currentQuantityScaled == beforeAsset.currentQuantityScaled + operation.quantityScaled
        : beforeAsset.currentQuantityScaled >= operation.quantityScaled
          && afterAsset.currentQuantityScaled == beforeAsset.currentQuantityScaled - operation.quantityScaled;
    }

    function isValidInvestmentOperationCreate(userId, operationId) {
      let data = request.resource.data;
      let assetPath = investmentAssetPath(userId, data.get('assetId', ''));
      return isValidInvestmentOperation(data, userId)
        && data.isVoided == false
        && data.voidedAt == null
        && data.mutationId == operationId
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision == 1
        && isActiveInvestmentPortfolio(userId, data.portfolioId)
        && exists(assetPath)
        && existsAfter(assetPath)
        && get(assetPath).data.portfolioId == data.portfolioId
        && get(assetPath).data.lastOperationId == data.previousOperationId
        && get(assetPath).data.lastOperationAt == data.previousOperationAt
        && getAfter(assetPath).data.lastOperationId == operationId
        && getAfter(assetPath).data.lastOperationAt == data.occurredAt
        && isOperationQuantityTransition(
          get(assetPath).data,
          getAfter(assetPath).data,
          data
        );
    }

    function isValidInvestmentAssetOperationAppend(userId, assetId, data) {
      let operationPath = investmentOperationPath(userId, data.lastOperationId);
      return existsAfter(operationPath)
        && getAfter(operationPath).data.assetId == assetId
        && getAfter(operationPath).data.portfolioId == data.portfolioId
        && getAfter(operationPath).data.previousOperationId == resource.data.lastOperationId
        && getAfter(operationPath).data.previousOperationAt == resource.data.lastOperationAt
        && getAfter(operationPath).data.occurredAt == data.lastOperationAt
        && getAfter(operationPath).data.isVoided == false
        && isOperationQuantityTransition(
          resource.data,
          data,
          getAfter(operationPath).data
        );
    }

    function isValidInvestmentAssetOperationVoid(userId, assetId, data) {
      let operationPath = investmentOperationPath(userId, resource.data.lastOperationId);
      return exists(operationPath)
        && existsAfter(operationPath)
        && get(operationPath).data.assetId == assetId
        && get(operationPath).data.isVoided == false
        && getAfter(operationPath).data.isVoided == true
        && data.lastOperationId == get(operationPath).data.previousOperationId
        && data.lastOperationAt == get(operationPath).data.previousOperationAt
        && (
          get(operationPath).data.kind == 'buy'
            ? resource.data.currentQuantityScaled >= get(operationPath).data.quantityScaled
              && data.currentQuantityScaled == resource.data.currentQuantityScaled - get(operationPath).data.quantityScaled
            : data.currentQuantityScaled == resource.data.currentQuantityScaled + get(operationPath).data.quantityScaled
        );
    }

    function isValidInvestmentAssetUpdate(userId, assetId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isValidInvestmentAsset(data, userId, assetId)
        && data.ownerId == resource.data.ownerId
        && data.portfolioId == resource.data.portfolioId
        && data.ticker == resource.data.ticker
        && data.name == resource.data.name
        && data.assetType == resource.data.assetType
        && data.currencyCode == resource.data.currencyCode
        && data.createdAt == resource.data.createdAt
        && data.schemaVersion == resource.data.schemaVersion
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && changed.hasAll(['currentQuantityScaled', 'lastOperationId', 'revision'])
        && changed.hasOnly([
          'currentQuantityScaled', 'lastOperationId', 'lastOperationAt',
          'updatedAt', 'revision'
        ])
        && isActiveInvestmentPortfolio(userId, data.portfolioId)
        && (
          data.lastOperationId != resource.data.lastOperationId
            && data.lastOperationId != null
            && isValidInvestmentAssetOperationAppend(userId, assetId, data)
          || resource.data.lastOperationId != null
            && isValidInvestmentAssetOperationVoid(userId, assetId, data)
        );
    }

    function isValidInvestmentOperationVoid(userId, operationId) {
      let data = request.resource.data;
      let assetPath = investmentAssetPath(userId, data.get('assetId', ''));
      let changed = data.diff(resource.data).affectedKeys();
      return isValidInvestmentOperation(data, userId)
        && resource.data.isVoided == false
        && data.isVoided == true
        && data.voidedAt == request.time
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && data.mutationId != resource.data.mutationId
        && changed.hasAll(['isVoided', 'voidedAt', 'mutationId', 'revision'])
        && changed.hasOnly([
          'isVoided', 'voidedAt', 'mutationId', 'updatedAt', 'revision'
        ])
        && exists(assetPath)
        && existsAfter(assetPath)
        && get(assetPath).data.lastOperationId == operationId
        && getAfter(assetPath).data.lastOperationId == data.previousOperationId
        && getAfter(assetPath).data.lastOperationAt == data.previousOperationAt
        && (
          data.kind == 'buy'
            ? get(assetPath).data.currentQuantityScaled >= data.quantityScaled
              && getAfter(assetPath).data.currentQuantityScaled == get(assetPath).data.currentQuantityScaled - data.quantityScaled
            : getAfter(assetPath).data.currentQuantityScaled == get(assetPath).data.currentQuantityScaled + data.quantityScaled
        );
    }

    function investmentIncomeFields() {
      return [
        'ownerId', 'portfolioId', 'assetId', 'incomeType', 'status',
        'inputMode', 'exDate', 'expectedPaymentDate', 'receivedDate',
        'eligibleQuantityScaled', 'unitAmountScaled', 'grossAmountCents',
        'withholdingTaxCents', 'netAmountCents', 'notes', 'originType',
        'externalId', 'cancelledAt', 'voidedAt', 'mutationId', 'createdAt',
        'updatedAt', 'schemaVersion', 'revision'
      ];
    }

    function isValidInvestmentIncomeAmounts(data) {
      let perUnitCents = data.inputMode == 'perUnit'
        && data.eligibleQuantityScaled is int
        && data.unitAmountScaled is int
          ? (data.eligibleQuantityScaled / 100000000.0)
            * (data.unitAmountScaled / 10000.0)
          : 0;
      return data.grossAmountCents is int
        && data.grossAmountCents >= 1
        && data.grossAmountCents <= 9999999999
        && data.withholdingTaxCents is int
        && data.withholdingTaxCents >= 0
        && data.withholdingTaxCents <= data.grossAmountCents
        && data.netAmountCents is int
        && data.netAmountCents ==
          data.grossAmountCents - data.withholdingTaxCents
        && (
          data.inputMode == 'total'
            ? data.eligibleQuantityScaled == null
              && data.unitAmountScaled == null
            : data.inputMode == 'perUnit'
              && data.eligibleQuantityScaled >= 1
              && data.eligibleQuantityScaled <= 999999999999999
              && data.unitAmountScaled >= 1
              && data.unitAmountScaled <= 999999999999
              && data.grossAmountCents - 0.5 <= perUnitCents
              && perUnitCents < data.grossAmountCents + 0.5
        );
    }

    function isValidInvestmentIncomeStatus(data) {
      return (
          data.status == 'expected'
            ? data.receivedDate == null
              && data.cancelledAt == null
              && data.voidedAt == null
            : data.status == 'received'
              ? data.receivedDate is timestamp
                && data.receivedDate <= request.time
                && data.cancelledAt == null
                && data.voidedAt == null
              : data.status == 'cancelled'
                ? data.receivedDate == null
                  && data.cancelledAt is timestamp
                  && data.voidedAt == null
                : data.status == 'voided'
                  && data.receivedDate is timestamp
                  && data.receivedDate <= request.time
                  && data.cancelledAt == null
                  && data.voidedAt is timestamp
        );
    }

    function isValidInvestmentIncome(data, userId) {
      return data.keys().hasAll(investmentIncomeFields())
        && data.keys().hasOnly(investmentIncomeFields())
        && data.ownerId == userId
        && data.portfolioId is string
        && data.portfolioId.size() >= 1
        && data.portfolioId.size() <= 128
        && data.assetId is string
        && data.assetId.size() >= 1
        && data.assetId.size() <= 160
        && data.incomeType in ['dividend', 'jcp', 'fiiIncome']
        && data.inputMode in ['total', 'perUnit']
        && (data.exDate == null || data.exDate is timestamp)
        && data.expectedPaymentDate is timestamp
        && data.notes is string
        && data.notes.size() <= 240
        && !data.notes.matches('.*[\\x00-\\x1F\\x7F].*')
        && data.originType == 'manual'
        && data.externalId == null
        && data.mutationId is string
        && data.mutationId.size() >= 1
        && data.mutationId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision >= 1
        && isValidInvestmentIncomeAmounts(data)
        && isValidInvestmentIncomeStatus(data);
    }

    function isCompatibleInvestmentIncome(assetType, incomeType) {
      return assetType == 'stock'
        ? incomeType in ['dividend', 'jcp']
        : assetType == 'fii' && incomeType == 'fiiIncome';
    }

    function hasValidInvestmentIncomeReferences(userId, data) {
      let portfolioPath = investmentPortfolioPath(userId, data.portfolioId);
      let assetPath = investmentAssetPath(userId, data.assetId);
      return existsAfter(portfolioPath)
        && existsAfter(assetPath)
        && getAfter(portfolioPath).data.ownerId == userId
        && getAfter(portfolioPath).data.isArchived == false
        && getAfter(assetPath).data.ownerId == userId
        && getAfter(assetPath).data.portfolioId == data.portfolioId
        && isCompatibleInvestmentIncome(
          getAfter(assetPath).data.assetType,
          data.incomeType
        );
    }

    function isValidInvestmentIncomeCreate(userId, eventId) {
      let data = request.resource.data;
      return isValidInvestmentIncome(data, userId)
        && data.status == 'expected'
        && data.receivedDate == null
        && data.cancelledAt == null
        && data.voidedAt == null
        && data.mutationId == eventId
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision == 1
        && hasValidInvestmentIncomeReferences(userId, data);
    }

    function isValidInvestmentIncomeExpectedEdit(userId, data, changed) {
      return data.status == 'expected'
        && changed.hasAny([
          'incomeType', 'inputMode', 'exDate', 'expectedPaymentDate',
          'eligibleQuantityScaled', 'unitAmountScaled', 'grossAmountCents',
          'withholdingTaxCents', 'netAmountCents', 'notes'
        ])
        && changed.hasOnly([
          'incomeType', 'inputMode', 'exDate', 'expectedPaymentDate',
          'eligibleQuantityScaled', 'unitAmountScaled', 'grossAmountCents',
          'withholdingTaxCents', 'netAmountCents', 'notes', 'mutationId',
          'updatedAt', 'revision'
        ])
        && hasValidInvestmentIncomeReferences(userId, data);
    }

    function isValidInvestmentIncomeReceive(userId, data, changed) {
      return data.receivedDate is timestamp
        && data.receivedDate <= request.time
        && changed.hasAll(['status', 'receivedDate', 'mutationId', 'revision'])
        && changed.hasOnly([
          'status', 'receivedDate', 'mutationId', 'updatedAt', 'revision'
        ])
        && hasValidInvestmentIncomeReferences(userId, data);
    }

    function isValidInvestmentIncomeCancel(data, changed) {
      return data.cancelledAt == request.time
        && changed.hasAll(['status', 'cancelledAt', 'mutationId', 'revision'])
        && changed.hasOnly([
          'status', 'cancelledAt', 'mutationId', 'updatedAt', 'revision'
        ]);
    }

    function isValidInvestmentIncomeVoid(data, changed) {
      return data.voidedAt == request.time
        && changed.hasAll(['status', 'voidedAt', 'mutationId', 'revision'])
        && changed.hasOnly([
          'status', 'voidedAt', 'mutationId', 'updatedAt', 'revision'
        ]);
    }

    function isValidInvestmentIncomeUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isValidInvestmentIncome(data, userId)
        && data.portfolioId == resource.data.portfolioId
        && data.assetId == resource.data.assetId
        && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && data.mutationId != resource.data.mutationId
        && (
          resource.data.status == 'expected'
            ? data.status == 'expected'
              ? isValidInvestmentIncomeExpectedEdit(userId, data, changed)
              : data.status == 'received'
                ? isValidInvestmentIncomeReceive(userId, data, changed)
                : isValidInvestmentIncomeCancel(data, changed)
            : resource.data.status == 'received'
              && isValidInvestmentIncomeVoid(data, changed)
        );
    }

    function isCurrentLegalProfileData(data, userId) {
      return hasExactProfileFields(data)
        && data.ownerId == userId
        && data.locale == 'pt-BR'
        && data.currencyCode == 'BRL'
        && data.timeZone == 'America/Sao_Paulo'
        && data.emailVerifiedSnapshot == true
        && data.termsVersionAccepted == 'terms-dev-1.0.0'
        && data.termsAcceptedAt is timestamp
        && data.privacyVersionAccepted == 'privacy-dev-1.0.0'
        && data.privacyAcceptedAt is timestamp
        && data.schemaVersion == 1;
    }

    function hasCurrentLegalProfile(userId) {
      let profilePath = /databases/$(database)/documents/users/$(userId);
      return !exists(profilePath)
        ? false
        : isCurrentLegalProfileData(get(profilePath).data, userId);
    }

    function hasFinancialAccess(userId) {
      return !isVerifiedOwner(userId)
        ? false
        : hasCurrentLegalProfile(userId);
    }

    function premiumEntitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/premium;
    }

    function premiumEntitlementFields() {
      return [
        'ownerId', 'planId', 'status', 'source', 'environment',
        'capabilities', 'startedAt', 'currentPeriodStart',
        'currentPeriodEnd', 'graceUntil', 'cancelAtPeriodEnd',
        'cancelledAt', 'expiredAt', 'revokedAt', 'refundedAt',
        'lastVerifiedAt', 'revision', 'schemaVersion', 'createdAt',
        'updatedAt'
      ];
    }

    function hasValidPremiumCapabilities(capabilities) {
      return capabilities is list
        && capabilities.size() <= 5
        && capabilities.toSet().size() == capabilities.size()
        && capabilities.hasOnly([
          'investmentsManual', 'investmentIncome', 'investmentQuotes',
          'investmentCalculators', 'investmentAnalysis'
        ]);
    }

    function hasValidPremiumPeriod(data) {
      return data.status == 'pending'
        ? data.startedAt == null
          && data.currentPeriodStart == null
          && data.currentPeriodEnd == null
        : data.startedAt is timestamp
          && data.currentPeriodStart is timestamp
          && data.currentPeriodEnd is timestamp
          && data.startedAt < data.currentPeriodEnd
          && data.currentPeriodStart >= data.startedAt
          && data.currentPeriodStart < data.currentPeriodEnd
          && data.lastVerifiedAt >= data.startedAt;
    }

    function hasValidPremiumLifecycleDates(data) {
      return (
          data.status == 'gracePeriod'
            ? data.graceUntil is timestamp
              && data.graceUntil > data.currentPeriodEnd
            : data.graceUntil == null
        )
        && (
          data.status == 'cancelled'
            ? data.cancelAtPeriodEnd == true
              && data.cancelledAt is timestamp
              && data.cancelledAt >= data.startedAt
              && data.cancelledAt <= data.lastVerifiedAt
            : data.status == 'expired' && data.cancelAtPeriodEnd == true
              ? data.cancelledAt is timestamp
                && data.cancelledAt >= data.startedAt
                && data.cancelledAt <= data.lastVerifiedAt
              : data.cancelAtPeriodEnd == false
                && data.cancelledAt == null
        )
        && (
          data.status == 'expired'
            ? data.expiredAt is timestamp
              && data.expiredAt >= data.currentPeriodEnd
              && data.expiredAt <= data.lastVerifiedAt
            : data.expiredAt == null
        )
        && (
          data.status == 'revoked'
            ? data.revokedAt is timestamp
              && data.revokedAt >= data.startedAt
              && data.revokedAt <= data.lastVerifiedAt
            : data.revokedAt == null
        )
        && (
          data.status == 'refunded'
            ? data.refundedAt is timestamp
              && data.refundedAt >= data.startedAt
              && data.refundedAt <= data.lastVerifiedAt
            : data.refundedAt == null
        );
    }

    function isValidPremiumEntitlementData(data, userId) {
      return data.keys().hasAll(premiumEntitlementFields())
        && data.keys().hasOnly(premiumEntitlementFields())
        && data.ownerId == userId
        && data.planId in ['monthly', 'annual']
        && data.status in [
          'pending', 'trialing', 'active', 'gracePeriod', 'accountHold',
          'paused', 'cancelled', 'expired', 'revoked', 'refunded'
        ]
        && data.source in [
          'googlePlay', 'administrativeGrant', 'developmentGrant',
          'closedTestGrant'
        ]
        && data.environment == 'development'
        && (data.status != 'pending' || data.source == 'googlePlay')
        && (data.source != 'closedTestGrant'
          || data.status == 'active' && data.capabilities.size() == 5
          || data.status == 'expired' && data.capabilities.size() == 0)
        && hasValidPremiumCapabilities(data.capabilities)
        && data.cancelAtPeriodEnd is bool
        && data.lastVerifiedAt is timestamp
        && data.revision is int
        && data.revision >= 1
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && data.updatedAt >= data.lastVerifiedAt
        && hasValidPremiumPeriod(data)
        && hasValidPremiumLifecycleDates(data);
    }

    function isPremiumFullAccess(data) {
      return request.time >= data.currentPeriodStart
        && (
          data.status in ['trialing', 'active', 'cancelled']
            ? request.time < data.currentPeriodEnd
            : data.status == 'gracePeriod'
              && request.time < data.graceUntil
        );
    }

    function isPremiumHistoricalRead(data) {
      return data.status in [
          'expired', 'accountHold', 'paused', 'revoked', 'refunded'
        ]
        || data.status in ['trialing', 'active', 'cancelled']
          && request.time >= data.currentPeriodEnd
        || data.status == 'gracePeriod'
          && request.time >= data.graceUntil;
    }

    function isValidPremiumMutationData(data, userId) {
      return data.keys().hasAll(premiumEntitlementFields())
        && data.keys().hasOnly(premiumEntitlementFields())
        && data.ownerId == userId
        && data.planId in ['monthly', 'annual']
        && data.source in [
          'googlePlay', 'administrativeGrant', 'developmentGrant',
          'closedTestGrant'
        ]
        && data.environment == 'development'
        && data.status in ['trialing', 'active', 'gracePeriod', 'cancelled']
        && hasValidPremiumCapabilities(data.capabilities)
        && (data.source != 'closedTestGrant' || data.capabilities.size() == 5)
        && data.currentPeriodStart is timestamp
        && data.currentPeriodEnd is timestamp
        && data.currentPeriodStart < data.currentPeriodEnd
        && data.revision is int
        && data.revision >= 1
        && data.schemaVersion == 1
        && (
          data.status == 'gracePeriod'
            ? data.graceUntil is timestamp
              && data.graceUntil > data.currentPeriodEnd
            : data.status == 'cancelled'
              ? data.cancelAtPeriodEnd == true
              : true
        );
    }

    function hasPremiumReadAccess(userId, capability) {
      let entitlementPath = premiumEntitlementPath(userId);
      let entitlement = get(entitlementPath);
      return hasFinancialAccess(userId)
        && exists(entitlementPath)
        && isValidPremiumEntitlementData(
          entitlement.data,
          userId
        )
        && capability in entitlement.data.capabilities
        && (
          isPremiumFullAccess(entitlement.data)
          || isPremiumHistoricalRead(entitlement.data)
        );
    }

    function hasPremiumMutationAccess(userId, capability) {
      let entitlementPath = premiumEntitlementPath(userId);
      let entitlement = get(entitlementPath);
      return hasFinancialAccess(userId)
        && exists(entitlementPath)
        && isValidPremiumMutationData(
          entitlement.data,
          userId
        )
        && capability in entitlement.data.capabilities
        && isPremiumFullAccess(entitlement.data);
    }

    function isActiveOwnerDocument(owner) {
      return owner.data.keys().hasAll([
          'role',
          'active',
          'environment',
          'grantedAt',
          'schemaVersion'
        ])
        && owner.data.keys().hasOnly([
          'role',
          'active',
          'environment',
          'grantedAt',
          'schemaVersion'
        ])
        && owner.data.role == 'owner'
        && owner.data.active == true
        && owner.data.environment == 'development'
        && owner.data.grantedAt is timestamp
        && owner.data.schemaVersion == 1;
    }

    match /system_admins/{adminUid} {
      allow get: if request.auth != null
        && request.auth.uid == adminUid
        && request.auth.token.email_verified == true
        && isActiveOwnerDocument(resource);
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId) && isValidCreate(userId);
      allow update: if isVerifiedOwner(userId) && isValidUpdate(userId);
      allow delete: if false;

      match /accounts/{accountId} {
        allow get, list: if hasFinancialAccess(userId);
        allow create: if hasFinancialAccess(userId)
          && isValidAccountCreate(userId);
        allow update: if hasFinancialAccess(userId)
          && isValidAccountUpdate(userId);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /categories/{categoryId} {
        allow get, list: if hasFinancialAccess(userId);
        allow create: if hasFinancialAccess(userId)
          && isValidCategoryCreate(userId);
        allow update: if hasFinancialAccess(userId)
          && isValidCategoryUpdate(userId);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /transactions/{transactionId} {
        allow get, list: if hasFinancialAccess(userId);
        allow create: if hasFinancialAccess(userId)
          && isValidTransactionCreate(userId, transactionId);
        allow update: if hasFinancialAccess(userId)
          && isValidTransactionUpdate(userId, transactionId);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /payables/{payableId} {
        allow get, list: if hasFinancialAccess(userId);
        allow create: if hasFinancialAccess(userId)
          && isValidCommitmentCreate(
            userId,
            'expense',
            'paid',
            'paidAt'
          );
        allow update: if hasFinancialAccess(userId)
          && isValidCommitmentUpdate(
            userId,
            'payable',
            payableId,
            'expense',
            'paid',
            'paidAt'
          );
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /receivables/{receivableId} {
        allow get, list: if hasFinancialAccess(userId);
        allow create: if hasFinancialAccess(userId)
          && isValidCommitmentCreate(
            userId,
            'income',
            'received',
            'receivedAt'
          );
        allow update: if hasFinancialAccess(userId)
          && isValidCommitmentUpdate(
            userId,
            'receivable',
            receivableId,
            'income',
            'received',
            'receivedAt'
          );
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /investmentPortfolios/{portfolioId} {
        allow get, list: if hasPremiumReadAccess(
          userId,
          'investmentsManual'
        );
        allow create: if hasPremiumMutationAccess(
            userId,
            'investmentsManual'
          )
          && isValidInvestmentPortfolioCreate(userId);
        allow update: if hasPremiumMutationAccess(
            userId,
            'investmentsManual'
          )
          && isValidInvestmentPortfolioUpdate(userId);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /investmentAssets/{assetId} {
        allow get, list: if hasPremiumReadAccess(
          userId,
          'investmentsManual'
        );
        allow create: if hasPremiumMutationAccess(
            userId,
            'investmentsManual'
          )
          && isValidInvestmentAssetCreate(userId, assetId);
        allow update: if hasPremiumMutationAccess(
            userId,
            'investmentsManual'
          )
          && isValidInvestmentAssetUpdate(userId, assetId);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /investmentOperations/{operationId} {
        allow get, list: if hasPremiumReadAccess(
          userId,
          'investmentsManual'
        );
        allow create: if hasPremiumMutationAccess(
            userId,
            'investmentsManual'
          )
          && isValidInvestmentOperationCreate(userId, operationId);
        allow update: if hasPremiumMutationAccess(
            userId,
            'investmentsManual'
          )
          && isValidInvestmentOperationVoid(userId, operationId);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /investmentIncomeEvents/{eventId} {
        allow get, list: if hasPremiumReadAccess(
          userId,
          'investmentIncome'
        );
        allow create: if hasPremiumMutationAccess(
            userId,
            'investmentIncome'
          )
          && isValidInvestmentIncomeCreate(userId, eventId);
        allow update: if hasPremiumMutationAccess(
            userId,
            'investmentIncome'
          )
          && isValidInvestmentIncomeUpdate(userId);
        allow delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /entitlements/{entitlementId} {
        allow get: if entitlementId == 'premium'
          && hasFinancialAccess(userId);
        allow list, create, update, delete: if false;

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /_premiumBillingEvents/{document=**} {
      allow read, write: if false;
    }

    match /_premiumPurchaseBindings/{document=**} {
      allow read, write: if false;
    }

    match /_premiumRtdnInbox/{document=**} {
      allow read, write: if false;
    }

    match /_premiumAcknowledgementOutbox/{document=**} {
      allow read, write: if false;
    }

    match /_premiumAdministrativeGrants/{document=**} {
      allow read, write: if false;
    }

    // Diretório interno do teste fechado e concessões individuais são
    // exclusivamente server-side. Nem o próprio testador nem owner podem
    // descobrir a lista, conceder, restaurar ou alterar esses documentos.
    match /_premiumClosedTestTesters/{document=**} {
      allow read, write: if false;
    }

    match /_premiumClosedTestGrants/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
