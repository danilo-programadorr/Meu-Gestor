{
  "functions": [
    {
      "source": "backend/functions/premium",
      "codebase": "premium",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".codex-tmp",
        "test"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
